              <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
            </column>
            <column caption='Discount Band' datatype='string' name='[Calculation_4972470662107147]' role='dimension' type='nominal' user:unnamed='Sheet 3'>
              <calculation class='tableau' formula='IF [discount] = 0 THEN &apos;0%&apos; ELSEIF [discount] &lt;= 0.2 THEN &apos;1-20%&apos; ELSEIF [discount] &lt;= 0.4 THEN &apos;21-40%&apos; ELSE &apos;41-80%&apos; END' />
            </column>
            <column caption='Profitability' datatype='string' name='[Calculation_4972470665723932]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([profit]) &lt; 0 THEN &apos;Unprofitable&apos; ELSE &apos;Profitable&apos; END' />
