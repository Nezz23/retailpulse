    <worksheet name='Discount vs Margin'>
      <table>
        <view>
          <datasources>
            <datasource caption='retailpulse_sales' name='federated.1v3zil81ekgd7u15t28b419jxmj6' />
          </datasources>
          <datasource-dependencies datasource='federated.1v3zil81ekgd7u15t28b419jxmj6'>
