      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_4972470664687635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales]) * 100' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_4972470664826900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount] = 0 THEN &apos;0%&apos; ELSEIF [discount] &lt;= 0.2 THEN &apos;1-20%&apos; ELSEIF [discount] &lt;= 0.4 THEN &apos;21-40%&apos; ELSE &apos;41-80%&apos; END' />
      </column>
      <column caption='Latest Year' datatype='integer' name='[Calculation_4972470664859669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(YEAR([order_date]))}' />
      </column>
      <column caption='Revenue (latest year)' datatype='real' name='[Calculation_4972470665076758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = [Calculation_4972470664859669] THEN [sales] END)' />
      </column>
      <column caption='Revenue PY' datatype='real' name='[Calculation_4972470665203735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = [Calculation_4972470664859669] - 1 THEN [sales] END)' />
      </column>
      <column caption='Profit (latest year)' datatype='real' name='[Calculation_4972470665256984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = [Calculation_4972470664859669] THEN [profit] END)' />
      </column>
      <column caption='Profit PY' datatype='real' name='[Calculation_4972470665310233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = [Calculation_4972470664859669] - 1 THEN [profit] END)' />
      </column>
      <column caption='Orders (latest year)' datatype='integer' name='[Calculation_4972470665568282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_date]) = [Calculation_4972470664859669] THEN [order_id] END)' />
      </column>
      <column caption='Orders PY' datatype='integer' name='[Calculation_4972470665674779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_date]) = [Calculation_4972470664859669] - 1 THEN [order_id] END)' />
      </column>
      <column caption='Profitability' datatype='string' name='[Calculation_4972470665723932]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([profit]) &lt; 0 THEN &apos;Unprofitable&apos; ELSE &apos;Profitable&apos; END' />
      </column>
      <column caption='KPI Revenue' datatype='string' name='[Calculation_4972470665777181]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;$&apos; + STR(ROUND([Calculation_4972470665076758] / 1000, 0)) + &apos;K&apos;' />
      </column>
      <column caption='KPI Revenue YoY' datatype='string' name='[Calculation_4972470665830430]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(IF [Calculation_4972470665076758] &gt;= [Calculation_4972470665203735] THEN &apos;▲ +&apos; ELSE &apos;▼ &apos; END) + STR(ROUND(([Calculation_4972470665076758] - [Calculation_4972470665203735]) / [Calculation_4972470665203735] * 100, 1)) + &apos;% vs last year&apos;' />
      </column>
      <column caption='KPI Profit' datatype='string' name='[Calculation_4972470665879583]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;$&apos; + STR(ROUND([Calculation_4972470665256984] / 1000, 0)) + &apos;K&apos;' />
      </column>
      <column caption='KPI Profit YoY' datatype='string' name='[Calculation_4972470665932832]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(IF [Calculation_4972470665256984] &gt;= [Calculation_4972470665310233] THEN &apos;▲ +&apos; ELSE &apos;▼ &apos; END) + STR(ROUND(([Calculation_4972470665256984] - [Calculation_4972470665310233]) / [Calculation_4972470665310233] * 100, 1)) + &apos;% vs last year&apos;' />
      </column>
      <column caption='KPI Margin' datatype='string' name='[Calculation_4972470665981985]' role='measure' type='nominal'>
