<?xml version='1.0' encoding='utf-8' ?>
<workbook source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'><datasources><datasource hasconnection='false' inline='true' name='Parameters' version='18.1'><column caption="Metric" datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='"Revenue"'><calculation class='tableau' formula='"Revenue"' /><members><member value='"Revenue"' /><member value='"Profit"' /><member value='"Profit Margin"' /></members></column><column caption="Top N" datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value="10"><calculation class='tableau' formula="10" /><members><member value="5" /><member value="10" /><member value="15" /><member value="20" /><member value="25" /></members></column><column caption="Discount Cap" datatype='real' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value="0.2"><calculation class='tableau' formula="0.2" /><members><member value="0.1" /><member value="0.2" /><member value="0.3" /><member value="0.4" /></members></column><column caption="Selected Region" datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='"All"'><calculation class='tableau' formula='"All"' /><members><member value='"All"' /><member value='"Central"' /><member value='"East"' /><member value='"South"' /><member value='"West"' /></members></column></datasource><datasource caption="Sales lines" inline='true' name='federated.sales_wide' version='18.1'><connection class='federated'><named-connections><named-connection caption="sales_wide" name='textscan.federated.sales_wide'><connection class='textscan' directory='../data/tableau' filename="sales_wide.csv" password='' server='' /></named-connection></named-connections><relation connection='textscan.federated.sales_wide' name="sales_wide.csv" table='[sales_wide#csv]' type='table'><columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='integer' name="row_id" ordinal='0' /><column datatype='string' name="order_id" ordinal='1' /><column datatype='date' name="order_date" ordinal='2' /><column datatype='date' name="ship_date" ordinal='3' /><column datatype='integer' name="days_to_ship" ordinal='4' /><column datatype='string' name="ship_mode" ordinal='5' /><column datatype='string' name="customer_id" ordinal='6' /><column datatype='string' name="customer_name" ordinal='7' /><column datatype='string' name="segment" ordinal='8' /><column datatype='string' name="country" ordinal='9' /><column datatype='string' name="region" ordinal='10' /><column datatype='string' name="state" ordinal='11' /><column datatype='string' name="city" ordinal='12' /><column datatype='string' name="postal_code" ordinal='13' /><column datatype='string' name="regional_manager" ordinal='14' /><column datatype='string' name="product_id" ordinal='15' /><column datatype='string' name="product_name" ordinal='16' /><column datatype='string' name="category" ordinal='17' /><column datatype='string' name="sub_category" ordinal='18' /><column datatype='integer' name="quantity" ordinal='19' /><column datatype='real' name="discount" ordinal='20' /><column datatype='real' name="gross_sales" ordinal='21' /><column datatype='real' name="discount_amount" ordinal='22' /><column datatype='real' name="sales" ordinal='23' /><column datatype='real' name="profit" ordinal='24' /><column datatype='real' name="implied_cost" ordinal='25' /><column datatype='boolean' name="is_returned" ordinal='26' /></columns></relation></connection><column caption="Revenue" datatype='real' name='[Calculation_0001]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([sales])" /></column><column caption="Total Profit" datatype='real' name='[Calculation_0002]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([profit])" /></column><column caption="Profit Margin" datatype='real' name='[Calculation_0003]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([profit]) / SUM([sales])" /></column><column caption="Orders" datatype='integer' name='[Calculation_0004]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([order_id])" /></column><column caption="AOV" datatype='real' name='[Calculation_0005]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([sales]) / COUNTD([order_id])" /></column><column caption="Discount Rate" datatype='real' name='[Calculation_0006]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([discount_amount]) / SUM([gross_sales])" /></column><column caption="Latest Year" datatype='integer' name='[Calculation_0007]' role='dimension' type='nominal'><calculation class='tableau' formula="{FIXED : MAX(YEAR([order_date]))}" /></column><column caption="Revenue CY" datatype='real' name='[Calculation_0008]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF YEAR([order_date]) = [Calculation_0007] THEN [sales] END)" /></column><column caption="Revenue PY" datatype='real' name='[Calculation_0009]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF YEAR([order_date]) = [Calculation_0007] - 1 THEN [sales] END)" /></column><column caption="Profit CY" datatype='real' name='[Calculation_0010]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF YEAR([order_date]) = [Calculation_0007] THEN [profit] END)" /></column><column caption="Profit PY" datatype='real' name='[Calculation_0011]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF YEAR([order_date]) = [Calculation_0007] - 1 THEN [profit] END)" /></column><column caption="Revenue YoY" datatype='real' name='[Calculation_0012]' role='measure' type='quantitative'><calculation class='tableau' formula="([Calculation_0008] - [Calculation_0009]) / [Calculation_0009]" /></column><column caption="Profit YoY" datatype='real' name='[Calculation_0013]' role='measure' type='quantitative'><calculation class='tableau' formula="([Calculation_0010] - [Calculation_0011]) / [Calculation_0011]" /></column><column caption="Revenue YoY (table calc)" datatype='real' name='[Calculation_0014]' role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([sales]) - LOOKUP(SUM([sales]), -1)) / ABS(LOOKUP(SUM([sales]), -1))" /></column><column caption="Rolling 3M Revenue" datatype='real' name='[Calculation_0015]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_AVG(SUM([sales]), -2, 0)" /></column><column caption="Running Revenue Share" datatype='real' name='[Calculation_0016]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_SUM(SUM([sales])) / TOTAL(SUM([sales]))" /></column><column caption="Selected Metric" datatype='real' name='[Calculation_0017]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN "Revenue" THEN SUM([sales]) WHEN "Profit" THEN SUM([profit]) WHEN "Profit Margin" THEN SUM([profit]) / SUM([sales]) END' /></column><column caption="Product Rank" datatype='integer' name='[Calculation_0018]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK_UNIQUE([Calculation_0017], 'desc')" /></column><column caption="Show Top N" datatype='boolean' name='[Calculation_0019]' role='measure' type='nominal'><calculation class='tableau' formula="[Calculation_0018] &lt;= [Parameters].[Parameter 2]" /></column><column caption="Show Bottom N" datatype='boolean' name='[Calculation_0020]' role='measure' type='nominal'><calculation class='tableau' formula="[Calculation_0018] &gt; WINDOW_MAX([Calculation_0018]) - [Parameters].[Parameter 2]" /></column><column caption="Company Margin" datatype='real' name='[Calculation_0021]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED : SUM([profit]) / SUM([sales])}" /></column><column caption="Margin vs Company" datatype='real' name='[Calculation_0022]' role='measure' type='quantitative'><calculation class='tableau' formula="[Calculation_0003] - MIN([Calculation_0021])" /></column><column caption="Margin Status" datatype='string' name='[Calculation_0023]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Calculation_0003] &lt; 0 THEN "Loss" ELSEIF [Calculation_0003] &lt; MIN([Calculation_0021]) THEN "Below company" ELSE "At or above company" END' /></column><column caption="Product Lifetime Profit" datatype='real' name='[Calculation_0024]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [product_id], [product_name] : SUM([profit])}" /></column><column caption="Unprofitable Product" datatype='boolean' name='[Calculation_0025]' role='dimension' type='nominal'><calculation class='tableau' formula="[Calculation_0024] &lt; 0" /></column><column caption="Customer First Order" datatype='date' name='[Calculation_0026]' role='dimension' type='ordinal'><calculation class='tableau' formula="{FIXED [customer_id] : MIN([order_date])}" /></column><column caption="Cohort Quarter" datatype='date' name='[Calculation_0027]' role='dimension' type='ordinal'><calculation class='tableau' formula="DATETRUNC('quarter', [Calculation_0026])" /></column><column caption="Quarters Since First" datatype='integer' name='[Calculation_0028]' role='dimension' type='nominal'><calculation class='tableau' formula="DATEDIFF('quarter', [Calculation_0027], DATETRUNC('quarter', [order_date]))" /></column><column caption="Cohort Size" datatype='integer' name='[Calculation_0029]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [Calculation_0027] : COUNTD([customer_id])}" /></column><column caption="Retention" datatype='real' name='[Calculation_0030]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([customer_id]) / MIN([Calculation_0029])" /></column><column caption="Customer Orders" datatype='integer' name='[Calculation_0031]' role='dimension' type='nominal'><calculation class='tableau' formula="{FIXED [customer_id] : COUNTD([order_id])}" /></column><column caption="Customer Lifetime Revenue" datatype='real' name='[Calculation_0032]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [customer_id] : SUM([sales])}" /></column><column caption="Repeat Customer" datatype='boolean' name='[Calculation_0033]' role='dimension' type='nominal'><calculation class='tableau' formula="[Calculation_0031] &gt; 1" /></column><column caption="Discount Band" datatype='string' name='[Calculation_0034]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [discount] = 0 THEN "0%" ELSEIF [discount] &lt;= 0.2 THEN "1-20%" ELSEIF [discount] &lt;= 0.4 THEN "21-40%" ELSE "41-80%" END' /></column><column caption="Above Discount Cap" datatype='boolean' name='[Calculation_0035]' role='dimension' type='nominal'><calculation class='tableau' formula="[discount] &gt; [Parameters].[Parameter 3]" /></column><column caption="Profit on Capped Lines" datatype='real' name='[Calculation_0036]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [discount] &gt; [Parameters].[Parameter 3] THEN [profit] END)" /></column><column caption="Is Selected Region" datatype='boolean' name='[Calculation_0037]' role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[Parameter 4] = "All" OR [region] = [Parameters].[Parameter 4]' /></column></datasource><datasource caption="Forecast" inline='true' name='federated.forecast' version='18.1'><connection class='federated'><named-connections><named-connection caption="forecast" name='textscan.federated.forecast'><connection class='textscan' directory='../data/tableau' filename="forecast.csv" password='' server='' /></named-connection></named-connections><relation connection='textscan.federated.forecast' name="forecast.csv" table='[forecast#csv]' type='table'><columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='date' name="month" ordinal='0' /><column datatype='string' name="series" ordinal='1' /><column datatype='real' name="revenue" ordinal='2' /><column datatype='real' name="forecast" ordinal='3' /><column datatype='real' name="lo80" ordinal='4' /><column datatype='real' name="hi80" ordinal='5' /><column datatype='real' name="lo95" ordinal='6' /><column datatype='real' name="hi95" ordinal='7' /><column datatype='real' name="actual" ordinal='8' /></columns></relation></connection></datasource></datasources></workbook>
